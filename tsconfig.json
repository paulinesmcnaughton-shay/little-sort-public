{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2020",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    "App.tsx",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
